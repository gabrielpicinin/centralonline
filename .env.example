# Copie para .env e preencha. O .env está no .gitignore e vale só para a sua
# máquina; no servidor da Central, estas variáveis são definidas no serviço.

# Chave que cifra o cookie de sessão. Mínimo de 32 caracteres — abaixo disso a
# aplicação recusa subir. Gere uma aleatória, não invente à mão:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Trocá-la derruba todas as sessões abertas E torna ilegíveis as senhas de
# pastor guardadas para o "Mostrar senha" — elas são cifradas com uma chave
# derivada deste segredo. O login continua funcionando (ele confere o hash), mas
# quem precisar ver a senha de um pastor vai ter que gerar uma nova.
SESSION_SECRET=

# Pasta onde o banco de dados mora. Opcional: sem ela, o app usa ./dados.
#
# É ESTA PASTA que precisa entrar na rotina de backup do TI — não há nada de
# valor fora dela. Contas, senhas, permissões e as bases enviadas estão todas
# no arquivo central.db lá dentro.
# DADOS_DIR=/var/lib/central-dashboard

# A flag `Secure` do cookie de sessao. OBRIGATORIA — sem ela o servico nao sobe.
#
#   true   o site e servido por HTTPS
#   false  o site e servido por HTTP
#
# Nao tem padrao de proposito, porque valor errado quebra o login SEM DEIXAR
# RASTRO: com o site em HTTP e a flag ligada, o navegador descarta o cookie de
# sessao e a pessoa cai de volta no login, sem mensagem de erro nenhuma.
#
# Nao existe chute seguro. `true` quebra quem nao tem HTTPS; `false` seria pior,
# porque entregaria sessao sem cifragem a quem TEM HTTPS e ninguem perceberia,
# ja que tudo funcionaria. Entao quem publica declara.
#
# Na implantacao interna atual, sem certificado: false
COOKIE_SECURE=false

# Interface em que o servidor compilado escuta.
#
# SEM ELA, O PADRÃO É ESCUTAR EM TODAS AS INTERFACES — a aplicação fica
# alcançável por qualquer máquina da rede, na porta do Node, passando por fora
# do proxy reverso e do HTTPS. O padrão vem do Nitro e não pode ser mudado pelo
# código deste projeto: o servidor compilado lê esta variável antes de executar
# qualquer linha nossa.
#
# Em produção, defina na configuração do serviço. Só quem vem pelo Apache entra.
# HOST=127.0.0.1

# Porta do servidor. Opcional: sem ela, o padrão do Node é 3000.
# PORT=8080

# --- Não existe mais ---------------------------------------------------------
# SITE_USERNAME e SITE_PASSWORD eram a senha única, igual para todos, de antes
# das contas por pessoa. Saíram na Fase 2. Se ainda estiverem no seu .env, pode
# apagar: nada as lê.
