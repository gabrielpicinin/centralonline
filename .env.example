# Copie para .env e preencha. O .env está no .gitignore e vale só para a sua
# máquina — no site publicado, estas três variáveis são definidas no projeto
# do Lovable, que é quem hospeda. Veja a seção "Segredos" do README.

# Quem entra no dashboard.
SITE_USERNAME=
SITE_PASSWORD=

# Chave que cifra o cookie de sessão. Mínimo de 32 caracteres — abaixo disso a
# aplicação recusa subir. Gere uma aleatória, não invente à mão:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
