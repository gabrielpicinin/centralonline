// Arquivo herdado do modelo TanStack Start. NÃO é usado para publicar este
// projeto: quem hospeda é o Lovable, e o site no ar é centralonline.lovable.app.
//
// Fica aqui porque o plugin da Cloudflare no build espera encontrá-lo. Não
// tente publicar por ele: um `wrangler deploy` a partir daqui criaria uma
// segunda cópia do site numa conta Cloudflare sua, separada, enquanto o site
// de verdade seguiria intocado.
//
// As credenciais (SITE_USERNAME, SITE_PASSWORD, SESSION_SECRET) são definidas
// no projeto do Lovable e, localmente, no .env. Nunca aqui — este arquivo é
// versionado, e o que entra num bloco "vars" fica em texto puro.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-start-app",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
}
